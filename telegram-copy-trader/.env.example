# Gizli bilgiler. Kullanım:  cp .env.example .env   (sonra doldurun)
# .env dosyasını KİMSEYLE paylaşmayın, git'e eklemeyin.
#
# Kurallar:
#  - Her satır DEGISKEN=deger ; "=" etrafında boşluk yok.
#  - Satır sonuna yorum (#) yazmayın; yorumlar ayrı satırda olsun.
#  - Boş bırakılan değişken "ayarlanmamış" sayılır.
#  - Şifre/passphrase gibi kendi belirlediğiniz değerleri tek tırnak içinde
#    çift tırnakla yazın; sadece rakamdan oluşsa, #, $ veya boşluk içerse de
#    bozulmaz:   MT5_PASSWORD='"12345678"'
#    (Değerin içinde " veya \ varsa bu biçimi kullanmayın.)

# --- Telegram kullanıcı hesabı (my.telegram.org -> API development tools) ---
TG_API_ID=
TG_API_HASH=
# İsteğe bağlı: 'python -m copytrader login' çıktısındaki oturum metni.
# Doluysa data/telegram_user.session dosyası yerine bu kullanılır.
# DİKKAT: Telegram hesabınıza TAM erişim verir.
TG_SESSION_STRING=

# --- Bildirim botu (@BotFather) ve kendi kullanıcı ID'niz (@userinfobot) ---
TG_BOT_TOKEN=
TG_OWNER_ID=

# --- Claude (console.anthropic.com -> API Keys) ---
ANTHROPIC_API_KEY=

# --- Binance USDⓈ-M vadeli (Futures izni AÇIK, para çekme KAPALI) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Bybit ---
BYBIT_API_KEY=
BYBIT_API_SECRET=

# --- OKX (passphrase = anahtarı oluştururken belirlediğiniz parola) ---
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# --- MT5 terminali (sadece Windows) ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# --- MetaApi (metaapi.cloud) ---
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=
